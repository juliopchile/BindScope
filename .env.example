# Copy this file to .env and edit as needed. .env is git-ignored.
#
#   cp .env.example .env
#
# Every variable is optional; the Makefile falls back to the defaults shown.

# Port for `make run`. Change this if 8080 is already taken on your machine.
PORT=8080

# Interface to bind to. Use 0.0.0.0 to reach the dev server from another
# device on your network (a phone, for checking responsive layout).
HOST=127.0.0.1
